<Window x:Class="StaffManagement.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StaffManagement.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RemindersViewModel}"
        Title="Nhắc hạn chức vụ" Width="1160" Height="560" MinWidth="800" MinHeight="360"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitle}" FontSize="15">
                <Run Text="🔔 " /><Run Text="{Binding CountText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Đóng" Command="{Binding CloseCommand}" MinWidth="80" Margin="0" />
            <StackPanel Orientation="Horizontal">
                <Button Content="✎  Sửa / cập nhật QĐ" Style="{StaticResource PrimaryButton}" Command="{Binding EditCommand}"
                        ToolTip="Mở dòng chức vụ để cập nhật (ví dụ đã bổ nhiệm lại) — nhấp đúp vào dòng cũng được" />
                <Button Content="✓  Đã xử lý / Nhắc lại" Command="{Binding ToggleDismissCommand}"
                        ToolTip="Ẩn nhắc nhở cho chức vụ này (cho đến khi ngày kết thúc thay đổi), hoặc bật lại nếu đã ẩn" />
                <CheckBox Content="Hiện cả mục đã ẩn" IsChecked="{Binding ShowDismissed}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dismissed}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Còn lại" Width="150" SortMemberPath="Item.DaysLeft">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ReminderRow}">
                                <Border x:Name="pill" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Background="#E8F0FB">
                                    <TextBlock x:Name="txt" Text="{Binding Item.CountdownText}" FontWeight="SemiBold" Foreground="#1E5AA8" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Item.Urgency}" Value="0">
                                        <Setter TargetName="pill" Property="Background" Value="#FDE7E7" />
                                        <Setter TargetName="txt" Property="Foreground" Value="#B42318" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.Urgency}" Value="1">
                                        <Setter TargetName="pill" Property="Background" Value="#FDE7E7" />
                                        <Setter TargetName="txt" Property="Foreground" Value="#B42318" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.Urgency}" Value="2">
                                        <Setter TargetName="pill" Property="Background" Value="#FFF4D6" />
                                        <Setter TargetName="txt" Property="Foreground" Value="#8A5A00" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ngày kết thúc" Width="105" Binding="{Binding Item.EndDate, StringFormat=dd/MM/yyyy}" SortMemberPath="Item.EndDate" />
                    <DataGridTextColumn Header="Lý do" Width="130" Binding="{Binding Item.ReasonText}" />
                    <DataGridTextColumn Header="Họ và tên" Width="170" Binding="{Binding Record.FullName}" />
                    <DataGridTextColumn Header="Chức vụ" Width="150" Binding="{Binding Record.Position}" />
                    <DataGridTextColumn Header="Đơn vị" Width="*" MinWidth="180" Binding="{Binding Record.Department}" />
                    <DataGridTextColumn Header="Số QĐ hiện tại" Width="130" Binding="{Binding Record.DecisionNumber}" />
                    <DataGridTextColumn Header="Nhắc lần tới" Width="100" Binding="{Binding NextText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="14"
                       Text="Không có chức vụ nào sắp kết thúc. 🎉"
                       Visibility="{Binding Rows.Count, Converter={StaticResource VisibleIf}, ConverterParameter=Invert}" />
        </Grid>
    </DockPanel>
</Window>
