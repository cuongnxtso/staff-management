<Window x:Class="StaffManagement.Views.DecisionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StaffManagement.ViewModels"
        xmlns:models="clr-namespace:StaffManagement.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DecisionImportViewModel}"
        Title="Đọc Quyết định bổ nhiệm" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type models:StaffRecord}">
            <TextBlock>
                <Run Text="{Binding Position, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Department, Mode=OneWay}" />
                <Run Text="{Binding DecisionNumber, Mode=OneWay, StringFormat='  (QĐ {0})'}" Foreground="{StaticResource MutedBrush}" />
                <Run Text="{Binding Status, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}" />
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="✨  Phân tích lại bằng AI" Command="{Binding ParseWithAiCommand}" Margin="0"
                    Visibility="{Binding CanUseAi, Converter={StaticResource VisibleIf}}"
                    ToolTip="Gửi nội dung quyết định tới dịch vụ AI đã cấu hình để trích xuất lại" />
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" FontSize="15">
                    <Run Text="📄 " /><Run Text="{Binding FileName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Text="Kiểm tra / sửa thông tin đã trích xuất ở bên trái (đối chiếu với văn bản gốc bên phải) trước khi lưu." />
                <TextBlock Text="{Binding WarningsText}" Foreground="#9A6700" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding WarningsText, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </DockPanel>

        <!-- Bottom: what will happen -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Background="{StaticResource PrimaryLightBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="💾  Lưu vào dữ liệu" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="130" />
                    <Button Content="Bỏ qua" Command="{Binding CancelCommand}" MinWidth="80" Margin="0" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding MatchInfo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Thao tác:" Style="{StaticResource Lbl}" />
                        <ComboBox Width="290" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" />
                        <TextBlock Text="Dòng áp dụng:" Style="{StaticResource Lbl}" Margin="16,4,10,4"
                                   Visibility="{Binding NeedsTarget, Converter={StaticResource VisibleIf}}" />
                        <ComboBox Width="430" ItemsSource="{Binding PersonRows}" SelectedItem="{Binding SelectedTarget}"
                                  ItemTemplate="{StaticResource RowTemplate}"
                                  Visibility="{Binding NeedsTarget, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding CanRetireOldRow, Converter={StaticResource VisibleIf}}">
                        <CheckBox Content="Đồng thời chuyển chức vụ cũ sang &quot;Đã thôi&quot; (khi được đề bạt):" IsChecked="{Binding RetireOldRow}"
                                  VerticalAlignment="Center" />
                        <ComboBox Width="430" Margin="10,0,0,0" ItemsSource="{Binding ActivePersonRows}" SelectedItem="{Binding OldRowToRetire}"
                                  ItemTemplate="{StaticResource RowTemplate}" IsEnabled="{Binding RetireOldRow}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorText, Converter={StaticResource VisibleIf}}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Extracted fields -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Loại quyết định" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" />

                        <TextBlock Grid.Row="1" Text="Họ và tên *" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Mã CB" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding StaffCode, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                 ToolTip="Dùng để tìm đúng cán bộ trong danh sách (ưu tiên hơn họ tên)" />

                        <TextBlock Grid.Row="2" Text="Ngày sinh" Style="{StaticResource Lbl}" />
                        <DatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding DateOfBirth}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Giới" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <ComboBox Grid.Row="2" Grid.Column="3" IsEditable="True" ItemsSource="{Binding GenderSuggestions}" Text="{Binding Gender}" />

                        <TextBlock Grid.Row="3" Text="Học hàm" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding RankSuggestions}" Text="{Binding AcademicRank}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Trình độ" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <ComboBox Grid.Row="3" Grid.Column="3" IsEditable="True" ItemsSource="{Binding DegreeSuggestions}" Text="{Binding Degree}" />

                        <TextBlock Grid.Row="4" Text="Chức danh NN" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding ProfessionalTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Chức danh nghề nghiệp, ví dụ Giảng viên chính (hạng II)" />

                        <TextBlock Grid.Row="5" Text="Chức vụ *" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" ItemsSource="{Binding PositionSuggestions}"
                                  Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" MaxDropDownHeight="320" />

                        <TextBlock Grid.Row="6" Text="Đơn vị" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" ItemsSource="{Binding DepartmentSuggestions}"
                                  Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" MaxDropDownHeight="320" />

                        <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PositionTextHint}" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" FontStyle="Italic"
                                   Visibility="{Binding PositionTextHint, Converter={StaticResource VisibleIf}}" />

                        <TextBlock Grid.Row="8" Text="Đơn vị cơ hữu" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True" ItemsSource="{Binding HomeUnitSuggestions}"
                                  Text="{Binding HomeUnit, UpdateSourceTrigger=PropertyChanged}" MaxDropDownHeight="320" />

                        <TextBlock Grid.Row="9" Text="Số QĐ" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding DecisionNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="Ngày QĐ" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <DatePicker Grid.Row="9" Grid.Column="3" SelectedDate="{Binding DecisionDate}" />

                        <TextBlock Grid.Row="10" Text="Hiệu lực từ ngày" Style="{StaticResource Lbl}" />
                        <DatePicker Grid.Row="10" Grid.Column="1" SelectedDate="{Binding EffectiveDate}" />
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="Thời hạn (năm)" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <TextBox Grid.Row="10" Grid.Column="3" Text="{Binding TermYears, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="11" Text="Đơn vị bổ nhiệm" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="11" Grid.Column="1" IsEditable="True" ItemsSource="{Binding UnitSuggestions}" Text="{Binding AppointingUnit}" />
                        <TextBlock Grid.Row="11" Grid.Column="2" Text="Cấp BN" Style="{StaticResource Lbl}" Margin="12,4,10,4" />
                        <ComboBox Grid.Row="11" Grid.Column="3" IsEditable="True" ItemsSource="{Binding LevelSuggestions}" Text="{Binding AppointingLevel}" />

                        <TextBlock Grid.Row="12" Grid.ColumnSpan="4" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Chức vụ / Đơn vị được tự động đối chiếu với cách ghi đang dùng trong danh sách (ví dụ &quot;Phòng Quản lý Đào tạo Sau đại học&quot; → &quot;Phòng QL ĐT SĐH&quot;). Năm hết hạn bổ nhiệm = năm hiệu lực + thời hạn (mặc định 5 năm)." />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Source text -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Văn bản gốc" Style="{StaticResource SectionTitle}" Margin="12,8" />
                    <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0,1,0,0"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Segoe UI" FontSize="12.5" Padding="10"
                             VerticalContentAlignment="Top" Margin="0" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
