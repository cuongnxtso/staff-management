<Window x:Class="StaffManagement.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Đồng ý" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" MinWidth="90" />
            <Button Content="Hủy" IsCancel="True" MinWidth="80" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
