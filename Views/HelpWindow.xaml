<Window x:Class="StaffManagement.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StaffManagement.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:HelpViewModel}"
        Title="Hướng dẫn sử dụng" Width="1000" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="TopicItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="5" Padding="10,7" Margin="0,1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- ===== Topics + search ===== -->
        <Border DockPanel.Dock="Left" Width="290" Style="{StaticResource Card}" Padding="10" Margin="0,0,12,0">
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}"
                         Tag="🔎  Tìm trong hướng dẫn (không cần dấu)…"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,8,0,0"
                           Text="Mẹo: bấm F1 ở bất kỳ đâu để mở hướng dẫn. Cửa sổ này có thể để mở bên cạnh khi làm việc." />
                <Grid>
                    <ListBox x:Name="TopicList" ItemsSource="{Binding Topics}" SelectedItem="{Binding Selected}" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TopicItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HelpTopic}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Icon}" Width="28" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Không tìm thấy nội dung phù hợp. Thử từ khóa khác, ví dụ &quot;lọc&quot;, &quot;xuất&quot;, &quot;QĐ&quot;."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,10"
                               Visibility="{Binding NothingFound, Converter={StaticResource VisibleIf}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Selected page ===== -->
        <Border Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <StackPanel DataContext="{Binding Selected}" d:DataContext="{d:DesignInstance vm:HelpTopic}">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding Icon}" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding StepItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HelpStep}">
                                <DockPanel Margin="0,0,0,10">
                                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="12" MinWidth="24" Height="24" Padding="7,0"
                                            VerticalAlignment="Top" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="13.5" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#FFF8E1" BorderBrush="#F3D27A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,8,0,0"
                            Visibility="{Binding HasTips, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="💡  Mẹo" FontWeight="SemiBold" Foreground="#8A5A00" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Tips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="•" Foreground="#8A5A00" Margin="2,0,8,0" />
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="19" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
